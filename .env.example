# LocalMart Frontend - Environment Variables

# ========================================
# Backend API URL (REQUIRED)
# ========================================
# Points to your NestJS backend. Update for production deployment.
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# ========================================
# Database Configuration (Supabase PostgreSQL)
# ========================================
DATABASE_URL="postgresql://username:password@host:port/database?schema=public"
DIRECT_URL="postgresql://username:password@host:port/database?schema=public"

# ========================================
# Supabase Configuration
# ========================================
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJxxx"
SUPABASE_SERVICE_ROLE_KEY="eyJxxx"

# ========================================
# Payment Gateway (Choose one)
# ========================================
# Stripe
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Razorpay (Alternative)
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="xxx"
RAZORPAY_WEBHOOK_SECRET="xxx"

# ========================================
# Google Maps API
# ========================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaxxx"

# ========================================
# Email Service (SendGrid)
# ========================================
SENDGRID_API_KEY="SG.xxx"
SENDGRID_FROM_EMAIL="noreply@localmart.com"
SENDGRID_FROM_NAME="LocalMart"

# ========================================
# SMS Service (Twilio)
# ========================================
TWILIO_ACCOUNT_SID="ACxxx"
TWILIO_AUTH_TOKEN="xxx"
TWILIO_PHONE_NUMBER="+1234567890"

# ========================================
# Application Configuration
# ========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="LocalMart"

# Node Environment
NODE_ENV="development"

# ========================================
# Redis (Optional - for caching)
# ========================================
REDIS_URL="redis://localhost:6379"

# ========================================
# Analytics & Monitoring
# ========================================
# Sentry
NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-xxx"

# ========================================
# Feature Flags
# ========================================
ENABLE_VENDOR_ANALYTICS="true"
ENABLE_REAL_TIME_TRACKING="true"
ENABLE_EMAIL_NOTIFICATIONS="true"
ENABLE_SMS_NOTIFICATIONS="false"

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# ========================================
# File Upload
# ========================================
MAX_FILE_SIZE_MB="5"
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"

# ========================================
# Telegram (username only — token is server-side)
# ========================================
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
